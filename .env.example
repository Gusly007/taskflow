PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_manager
DB_USER=postgres
DB_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
NODE_ENV=development

# Optional — auth rate limiting (per IP): max attempts per window, in minutes
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Optional — number of reverse proxies in front of the API (Render, Fly, nginx...), 0 if none
TRUST_PROXY=0
